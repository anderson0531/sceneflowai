{
  "name": "sceneflowai",
  "version": "1.0.0",
  "description": "AI-powered video creation platform with intelligent scene management",
  "main": "sceneflow-ai-nextjs",
  "scripts": {
    "dev": "npm --prefix sceneflow-ai-nextjs run dev",
    "build": "npm --prefix sceneflow-ai-nextjs run build",
    "start": "npm --prefix sceneflow-ai-nextjs run start",
    "lint": "npm --prefix sceneflow-ai-nextjs run lint",
    "deploy": "bash scripts/deploy-production.sh",
    "deploy:prod": "bash scripts/deploy-production.sh",
    "deploy:dol": "bash sceneflow-ai-nextjs/deploy-dol-production.sh"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.5",
    "next": "^16.2.2"
  },
  "keywords": [
    "ai",
    "video",
    "storyboard",
    "scene-direction",
    "gemini",
    "nextjs",
    "typescript"
  ],
  "author": "SceneFlow AI Team",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anderson0531/sceneflowai.git"
  },
  "bugs": {
    "url": "https://github.com/anderson0531/sceneflowai/issues"
  },
  "homepage": "https://sceneflowai.com"
}
